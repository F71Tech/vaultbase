# Copiá este archivo como ".env" y cambiá los valores.
# El .env real NO se sube a GitHub (está en .gitignore).

APP_NAME=VaultBase
# development (tu PC) o production (servidor)
APP_ENV=development
# Clave para firmar los tokens del login. En producción: larga y aleatoria (32+ caracteres).
# Generar una:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiame-por-una-clave-larga-y-secreta
# SQLite en local. En producción, la URL de PostgreSQL (ej. la que da Neon).
DATABASE_URL=sqlite:///./vaultbase.db
# Minutos que dura la sesión antes de tener que volver a loguearse
ACCESS_TOKEN_EXPIRE_MINUTES=43200
