# Copiá este archivo como ".env" y cambiá los valores.
# El .env real NO se sube a GitHub (está en .gitignore).

APP_NAME=VaultBase
# Clave para firmar los tokens del login. En producción usá una larga y aleatoria.
SECRET_KEY=cambiame-por-una-clave-larga-y-secreta
# SQLite en local. En producción será una URL de PostgreSQL.
DATABASE_URL=sqlite:///./vaultbase.db
# Minutos que dura la sesión antes de tener que volver a loguearse
ACCESS_TOKEN_EXPIRE_MINUTES=1440
